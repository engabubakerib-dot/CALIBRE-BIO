# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Load with:  set -a; source .env; set +a

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# NCBI: optional, raises the E-utilities rate limit from 3 to 10 requests/second
NCBI_API_KEY=

# local vLLM servers ignore the value unless started with --api-key
VLLM_API_KEY=EMPTY

# CALIBRE_OFFLINE=1 disables every network resolver: layers return "unknown", never a
# false negative. Use it for unit tests and for reproducing a run from the cache.
CALIBRE_OFFLINE=0
CALIBRE_CACHE_DIR=.cache/resolvers
CALIBRE_LOG_DIR=experiments/logs
